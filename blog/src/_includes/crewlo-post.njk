---
layout: crewlo-base.njk
---
<article class="journal-article wrap">
  <a class="text-link" href="../">← Back to the journal</a>
  <header class="article-header"><p class="eyebrow">{{ categoryLabel }}</p><h1>{{ title }}</h1><p class="article-deck">{{ description }}</p><p class="article-meta">By Hafid Idrissi · <time datetime="{{ page.date | htmlDate }}">{{ page.date | readableDate }}</time> · {{ content | readingTime }} min read</p></header>
  <div class="article-body">{{ content | safe }}</div>
  <aside class="article-next"><p class="eyebrow">KEEP EXPLORING</p><h2>{{ nextTitle }}</h2><a class="text-link" href="../{{ nextSlug }}/">Read the next article →</a></aside>
</article>
