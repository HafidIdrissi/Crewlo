{
  "name": "crewlo-journal",
  "version": "0.1.0",
  "private": true,
  "description": "Hafid Idrissi's Crewlo journal, built with Eleventy for GitHub Pages.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "npm run clean && eleventy && node scripts/postbuild.mjs",
    "dev": "eleventy --serve --port=8088",
    "dev:press": "node scripts/run-theme.mjs --theme=press --serve --port=8089",
    "clean": "rimraf ../docs/blog",
    "media": "node scripts/build-media-manifest.mjs",
    "preview:sunroom": "node scripts/run-theme.mjs --clean=../docs/blog-preview-sunroom --theme=sunroom --preview=1 --base=/blog-preview-sunroom --out=../docs/blog-preview-sunroom",
    "preview:press": "node scripts/run-theme.mjs --clean=../docs/blog-preview-press --theme=press --preview=1 --base=/blog-preview-press --out=../docs/blog-preview-press",
    "previews": "npm run preview:sunroom && npm run preview:press",
    "test:launcher": "node --test"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.0",
    "luxon": "^3.5.0",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "rimraf": "^6.0.1"
  }
}
